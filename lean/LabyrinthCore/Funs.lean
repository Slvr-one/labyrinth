def tree.reaches_loop
  (parents : Slice Std.Usize) (child : Std.Usize) (n : Std.Usize)
  (cur : Std.Usize) (steps : Std.Usize) :
  Result Bool
  := do
  loop
    (fun (cur1, steps1) => tree.reaches_loop.body parents child n cur1 steps1)
    (cur, steps)


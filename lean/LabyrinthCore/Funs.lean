@[rust_loop_body]
def tree.reaches_loop.body
  (parents : Slice Std.Usize) (child : Std.Usize) (n : Std.Usize)
  (cur : Std.Usize) (steps : Std.Usize) :
  Result (ControlFlow (Std.Usize × Std.Usize) Bool)
  := do
  if steps < n
  then
    if cur = child
    then ok (done true)
    else
      let cur1 ← Slice.index_usize parents cur
      let steps1 ← steps + 1#usize
      ok (cont (cur1, steps1))
  else ok (done false)


/-- [labyrinth_core::tree::set_parent]:
    Source: 'src/tree.rs', lines 30:0-43:1
    Visibility: public -/
def tree.set_parent
  (parents : Slice Std.Usize) (child : Std.Usize) (new_parent : Std.Usize) :
  Result ((core.result.Result Unit tree.Error) × (Slice Std.Usize))
  := do
  let n := Slice.len parents
  if child >= n
  then ok (core.result.Result.Err tree.Error.InvalidIndex, parents)
  else
    if new_parent >= n
    then ok (core.result.Result.Err tree.Error.InvalidIndex, parents)
    else
      if child = new_parent
      then ok (core.result.Result.Err tree.Error.SelfParent, parents)
      else
        let b ← tree.reaches parents child new_parent
        if b
        then ok (core.result.Result.Err tree.Error.Cycle, parents)
        else
          let parents1 ← Slice.update parents child new_parent
          ok (core.result.Result.Ok (), parents1)

/-- [labyrinth_core::tree::random_reparent]:
    Source: 'src/tree.rs', lines 46:0-57:1
    Visibility: public -/
def tree.random_reparent
  {R : Type _} (RngInst : tree.Rng R) (parents : Slice Std.Usize)
  (child : Std.Usize) (rng : R) :
  Result ((core.result.Result Unit tree.Error) × (Slice Std.Usize) × R)
  := do
  let n := Slice.len parents
  if n = 0#usize
  then ok (core.result.Result.Err tree.Error.InvalidIndex, parents, rng)
  else
    let (candidate, rng1) ← RngInst.next_below rng n
    let (r, parents1) ← tree.set_parent parents child candidate
    ok (r, parents1, rng1)

